{
	"name": "@krowten/svelte-heroicons",
	"version": "0.2.0",
	"description": "Heroicons for Svelte 5: all 324 outline and solid icons through one typed <Icon name> component or as tree-shakeable components",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/krowten/svelte-heroicons.git"
	},
	"homepage": "https://krowten.github.io/svelte-heroicons/",
	"author": {
		"name": "krowten",
		"email": "me@krowten.dev",
		"url": "https://github.com/krowten"
	},
	"license": "MIT",
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"heroicons",
		"svelte-heroicons",
		"heroicons-svelte",
		"icons",
		"icon",
		"svelte-icons",
		"svg-icons",
		"svg",
		"svelte-components",
		"icon-components",
		"tailwindcss",
		"tailwind",
		"typescript",
		"runes"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun run package",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepack": "bun run package",
		"generate": "bun scripts/generate.ts",
		"images": "bun scripts/images.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test": "bun run generate --check && vitest --run && playwright test",
		"prepublishOnly": "bun run lint && bun run check && bun run generate --check && vitest --run"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": false,
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./Icon.svelte": {
			"types": "./dist/Icon.svelte.d.ts",
			"svelte": "./dist/Icon.svelte"
		},
		"./icons/*": {
			"types": "./dist/icons/*.d.ts",
			"svelte": "./dist/icons/*"
		},
		"./icon-set": {
			"types": "./dist/icon-set.d.ts",
			"default": "./dist/icon-set.js"
		},
		"./package.json": "./package.json"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.4",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"heroicons": "^2.2.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	}
}
